---

<section
  class="mt-10 py-10 container mx-auto"
  id="visitantes"
  data-aos="fade-zoom-in"
  data-aos-easing="ease-in-back"
  data-aos-delay="800"
  data-aos-duration="1000"
  data-aos-offset="0"
  
>
  <h2
    class="text-[#2366e7] text-4xl md:text-5xl font-extrabold text-center md:p-10 uppercase"
  >
    {t("home.testimonial")}
  </h2>
  <!-- Grid de videos de Instagram con información de testimonios -->
  <TestimonialGrid instagramUrls={instagramVideos} testimonials={testimonials} language={language} client:load />
</section>
