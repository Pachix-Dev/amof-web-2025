---
import i18next, { t } from "i18next";
import { Image } from "astro:assets";
import { rates_eco } from "../../constans_rates.js";

const language = i18next.language;
---
<section class="my-20 px-4 sm:px-0">
  <div class="flex md:flex-row flex-col justify-center items-center md:gap-10">
    <p class='md:text-right text-center font-extrabold text-5xl pb-4 text-green-eco-dark uppercase text-[#2366e7]'>
      AMERICAS' Mobility of the Future <br> {t("rates.title")} 2026
    </p>
    <Image
      src="/img/eco-stand.webp"
      alt="Eco-Stand"
      width={300}
      height="200"
      loading="lazy"
    />
  </div>
  <div class="min-h-screen flex flex-col items-center py-12 px-4 sm:px-0">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 max-w-4xl w-full">
      {
        (() => {
          const colors = [
            "#3346D3",
            "#E65E2F"
          ];
          return rates_eco.rates.map((rate, idx) => {
            const accent = colors[idx % colors.length];
            return (
              <div class="shadow-xl rounded-3xl border border-gray-200 p-4 bg-gray-200">
                <div class="flex flex-col h-full bg-white rounded-3xl">
                  <div
                  style={`background: ${accent}`}
                  class="text-white text-center py-4 rounded-t-3xl text-4xl font-extrabold uppercase"
                >
                  {language === "en" ? rate.title.en : rate.title.es}
                  <p class="text-center mt-2 text-xl font-medium italic lowercase">
                    {language === "en" ? rate.size.en : rate.size.es}
                  </p>
                </div>
                <div class="text-center text-gray-500 mt-5 ">
                  <p class=" text-xl font-semibold">
                    {language === "en"
                      ? rate.regular_price_title.en
                      : rate.regular_price_title.es}
                  </p>
                  <hr class="mt-6 mb-4 border-gray-300" />
                  <p class="text-4xl font-extrabold">
                    {language === "en"
                      ? rate.regular_price.en
                      : rate.regular_price.es}
                  </p>
                  <hr class="mt-6 mb-4 border-gray-300" />
                </div>
                <ul class="px-8 mt-8 space-y-6 text-gray-700 text-[15px]">
                  {rate.items.map((item) => (
                    <li class="flex gap-3">
                      <span
                        class="text-white rounded-full p-1 flex items-center justify-center w-6 h-6"
                        style={`background: ${accent}`}
                      >
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          class="w-4 h-4"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="3"
                            d="M5 13l4 4L19 7"
                          />
                        </svg>
                      </span>
                      <span class="text-sm">
                        {language === "en"
                          ? item.description.en
                          : item.description.es}
                      </span>
                    </li>
                  ))}
                </ul>
                <hr class="mt-8 mb-6 border-gray-300" />
                <p
                  class="text-center font-extrabold text-sm pb-8 px-5"
                  style={`color: ${accent}`}
                >
                  {language === "en" ? rate.not_included.en : rate.not_included.es}
                </p>
                </div>
              </div>
            );
          });
        })()
      }
    </div>
    <p class="mt-10 text-xl text-gray-700 italic font-medium text-center">
      {t("rates.text_invitation")}
    </p>
  </div>
</section>
<style>
  section .grid > div {
    box-shadow: 0 18px 40px rgba(17, 24, 39, 0.12);
    transition: transform 200ms ease, box-shadow 200ms ease;
  }

  section .grid > div:hover {
    transform: translateY(-8px);
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.185);
  }
</style>