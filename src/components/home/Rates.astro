---
import i18next, { t } from "i18next";
import { Image } from "astro:assets";
import { rates_eco } from "../../constans_rates.js";

const language = i18next.language;
const ACCENT_COLORS = ["#3346D3", "#E65E2F"];
---

<section class="my-20 px-4 sm:px-0">
  <!-- Header Section -->
  <div class="flex md:flex-row flex-col justify-center items-center md:gap-10">
    <h1
      class="md:text-right text-center font-extrabold text-3xl sm:text-4xl md:text-5xl pb-4 uppercase text-[#2366e7]"
    >
      AMERICAS' Mobility of the Future <br />
      {t("rates.title")} 2026
    </h1>
    <Image
      src="/img/eco-stand.webp"
      alt="Eco-Stand"
      width={300}
      height={200}
      loading="lazy"
    />
  </div>

  <!-- Rates Grid -->
  <div class="min-h-screen flex flex-col items-center py-12 px-4 sm:px-0">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 max-w-4xl w-full">
      {rates_eco.rates.map((rate, idx) => {
        const accent = ACCENT_COLORS[idx % ACCENT_COLORS.length];
        
        return (
          <div class="rate-card shadow-xl rounded-3xl border border-gray-200 p-4 bg-gray-200">
            <div class="flex flex-col h-full bg-white rounded-3xl">
              
              <!-- Card Header -->
              <div
                style={`background: ${accent}`}
                class="text-white text-center py-4 rounded-t-3xl text-2xl sm:text-3xl md:text-4xl font-extrabold uppercase"
              >
                {language === "en" ? rate.title.en : rate.title.es}
                <p class="text-center mt-2 text-base sm:text-lg md:text-xl font-medium italic lowercase">
                  {language === "en" ? rate.size.en : rate.size.es}
                </p>
              </div>

              <!-- Pricing Section -->
              <div class="text-center py-6">
                <!-- Early Bird Price -->
                <h2
                  class="text-lg sm:text-xl font-bold tracking-wide uppercase"
                  style={`color: ${accent}`}
                >
                  {language === "en" ? rate.early_price_title.en : rate.early_price_title.es}
                </h2>
                <p class="mt-3 text-3xl sm:text-4xl md:text-5xl font-extrabold">
                  {language === "en" ? rate.early_price.en : rate.early_price.es}
                </p>
                <p class="mt-2 text-base text-gray-600 italic">
                  {language === "en" ? rate.per_sqm.en : rate.per_sqm.es}
                </p>

                <hr class="mt-6 mb-6 border-gray-300" />

                <!-- Regular Price -->
                <p class="text-base sm:text-lg font-bold tracking-wide uppercase text-gray-700">
                  {language === "en" ? rate.regular_price_title.en : rate.regular_price_title.es}
                </p>
                <p class="mt-2 text-2xl sm:text-3xl font-extrabold text-gray-800">
                  {language === "en" ? rate.regular_price.en : rate.regular_price.es}
                </p>
                <p class="text-base text-gray-600 italic">
                  {language === "en" ? rate.per_sqm.en : rate.per_sqm.es}
                </p>

                <hr class="mt-6 mb-4 border-gray-300" />
              </div>

              <!-- Features List -->
                <p class="text-center font-bold text-lg uppercase tracking-wide px-8 mb-4" style={`color: ${accent}`}>
                {language === "en" ? rate.includes_title.en : rate.includes_title.es}
                </p>
              <ul class="px-8 space-y-6 text-gray-700 text-[15px]">
                {rate.items.map((item) => (
                  <li class="flex gap-3">
                    <span
                      class="text-white rounded-full p-1 flex items-center justify-center w-6 h-6 flex-shrink-0"
                      style={`background: ${accent}`}
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="w-4 h-4"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="3"
                          d="M5 13l4 4L19 7"
                        />
                      </svg>
                    </span>
                    <span class="text-sm">
                      {language === "en" ? item.description.en : item.description.es}
                    </span>
                  </li>
                ))}
              </ul>

              <!-- Footer Note -->
              <p
                class="text-center font-bold text-sm pb-8 px-5 py-10 md:mt-6"
                style={`color: ${accent}`}
              >
                {language === "en" ? rate.not_included.en : rate.not_included.es}
              </p>
            </div>
          </div>
        );
      })}
    </div>

    <!-- Additional Information -->
    <p
      class="mt-10 mx-4 sm:mx-10 md:mx-20 text-center text-gray-600 font-bold text-lg sm:text-xl"
      set:html={t("home.discount")}
    />
    <p class="mt-10 text-base sm:text-lg md:text-xl text-gray-700 italic font-medium text-center px-4">
      {t("rates.text_invitation")}
    </p>
  </div>
</section>
<style>
  .rate-card {
    box-shadow: 0 18px 40px rgba(17, 24, 39, 0.12);
    transition:
      transform 200ms ease,
      box-shadow 200ms ease;
  }

  .rate-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.185);
  }
</style>
