---
import { TextReveal } from "../magicui/text-reveal";
import { t } from "i18next";
import FreeRegister from "./FreeRegister.astro";
import i18next from "i18next";


const lang = i18next.language;

---

<section class="relative overflow-hidden min-h-screen md:h-screen flex items-center justify-center">
  <video
    src="/video/amof_back_2026.mp4"
    poster="/img/background_about.webp"
    muted
    loop
    playsinline
    autoplay
    class="absolute inset-0 w-full h-full object-cover"
  ></video>
  
  <!-- información del evento -->
  <div class="absolute inset-0 bg-gradient-to-br from-[#0d1b2a]/80 via-[#1b263b]/70 to-[#2366e7]/60 flex items-center justify-center py-8 md:py-4">
    <div class="text-center text-white px-3 max-w-5xl w-full" data-aos="zoom-in" data-aos-duration="1200">
      
      <!-- Fecha con diseño destacado -->
      <div class="mb-3 md:mb-4 relative inline-block w-full sm:w-auto" data-aos="fade-up" data-aos-delay="200">
        <div class="absolute inset-0 bg-gradient-to-r from-[#2366e7] to-[#0d6e3c] blur-xl opacity-50"></div>
        <div class="relative bg-white/10 backdrop-blur-md border border-white/20 rounded-xl md:rounded-2xl px-4 py-2 sm:px-5 sm:py-2.5 md:px-8 md:py-3.5 mx-2 sm:mx-0">
          <p class="text-lg sm:text-xl md:text-2xl lg:text-3xl font-black uppercase tracking-tight bg-gradient-to-r from-white via-blue-100 to-green-100 bg-clip-text text-transparent drop-shadow-lg">
            {t("hero.date_event")}
          </p>
        </div>
      </div>
      
      <!-- Logo -->
      <div class="relative mb-3 md:mb-5" data-aos="fade-up" data-aos-delay="400">
        <div class="absolute inset-0 bg-gradient-to-r from-[#2366e7]/30 via-white/20 to-[#0d6e3c]/30 blur-3xl"></div>
        <img 
          src="/img/amof_logo_2026.webp" 
          alt="AMOF 2026" 
          class="relative w-48 sm:w-56 md:w-72 lg:w-80 mx-auto drop-shadow-2xl"
        />
      </div>
      
      <!-- Descripción - La Feria de la Movilidad -->
      <div class="mb-3 md:mb-4" data-aos="fade-up" data-aos-delay="600">
        <p class="text-base sm:text-lg md:text-xl lg:text-2xl tracking-wide drop-shadow-lg leading-tight font-bold px-2">
          {t("hero.description")}
        </p>
      </div>
      
      <!-- Lugar con iconos -->
      <div class="mb-4 md:mb-5" data-aos="fade-up" data-aos-delay="800">
        <div class="flex items-center justify-center gap-2 mb-1">
          <svg class="w-4 h-4 sm:w-5 sm:h-5 md:w-6 md:h-6 text-[#2366e7]" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
          </svg>
          <p class="text-lg sm:text-xl md:text-2xl lg:text-3xl font-bold drop-shadow-lg">
            EXPO GUADALAJARA
          </p>
        </div>
        <p class="text-sm sm:text-base md:text-lg lg:text-xl font-light drop-shadow-lg text-white/90">
          Jalisco, México
        </p>
      </div>
      
      <!-- Botón CTA moderno y llamativo -->
      <div class="flex justify-center items-center px-4 mb-4 md:mb-5">
        <a 
          href={lang === "en" ? "https://ecomondomexico.com.mx/en/registro/" : "https://ecomondomexico.com.mx/registro/"}
          class="group relative inline-flex items-center justify-center overflow-hidden bg-gradient-to-br from-[#2366e7] via-[#1a4db8] to-[#0d6e3c] px-6 py-3 sm:px-8 sm:py-4 md:px-12 md:py-5 rounded-xl md:rounded-2xl text-base sm:text-lg md:text-xl font-black uppercase tracking-wider text-white shadow-2xl transition-all duration-300 hover:scale-105 md:hover:scale-110 hover:shadow-[0_0_40px_rgba(35,102,231,0.8)] transform hover:-translate-y-1"
        >
          <span class="absolute inset-0 bg-white/20 transform scale-x-0 group-hover:scale-x-100 transition-transform duration-500 origin-left"></span>
          <span class="relative flex items-center gap-2 sm:gap-3">
            <svg class="w-5 h-5 sm:w-6 sm:h-6 md:w-7 md:h-7 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z"/>
            </svg>
            {lang === "en" ? "Register Free Now" : "¡Regístrate Gratis!"}
          </span>
        </a>
      </div>
      
      <!-- Logos de Organizadores -->
      <div class="flex items-center justify-center gap-6 md:gap-10">
        <img 
          src="/img/igeco_bn.webp" 
          alt="IGeco" 
          class="w-24 sm:w-28 md:w-36 lg:w-40 h-auto drop-shadow-xl"
        />
        <img 
          src="/img/deutsche_messe_bn.webp" 
          alt="Deutsche Messe" 
          class="w-24 sm:w-28 md:w-36 lg:w-40 h-auto drop-shadow-xl"
        />
      </div>
    </div>
  </div>
</section>

