---
import { TextReveal } from '../magicui/text-reveal'
import { t } from 'i18next'
import FreeRegister from './FreeRegister.astro'
---

<section class='relative flex items-center justify-center overflow-hidden'>
  <!-- Imagen de fondo hero -->
  <img
    src='/img/bg_amof_nuevo_2025.webp'
    class='w-full h-screen object-cover absolute top-0 left-0'
    alt='AMOF 2025 Background'
  />

  <!-- Overlay con gradiente -->
  <div
    class='absolute inset-0 bg-gradient-to-b from-black/30 via-transparent to-black/50'
  >
  </div>

  <!-- Contenido del Hero -->
  <div
    class='relative z-10 w-full h-screen flex flex-col items-center justify-center px-4'
  >
    <!-- Video Section -->
    <div class='mb-12 w-full max-w-2xl'>
      <div class='group relative cursor-pointer'>
        <!-- Video thumbnail -->
        <div class='relative rounded-2xl overflow-hidden shadow-2xl'>
          <!-- Play button overlay -->
          <a
            href='https://ecomondomexico.com.mx/'
            target='_blank'
            rel='noopener noreferrer'
            class='w-full h-auto object-cover transition-transform duration-300 group-hover:scale-105'
          >
            <video
              src='/video/AMOF_A_ECO_VIDEO_2026.mp4'
              class=''
              muted
              loop
              playsinline
              autoplay></video>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Sección de registro y información -->
<div
  class='bg-[url(/img/bg_amof_gradient.webp)] bg-top bg-no-repeat relative'
  style='background-size: 100% 100%;'
>
  <FreeRegister />

  <TextReveal
    client:only
    text={`${t('home.titleCounter')}, 2025 CENTRO BANAMEX, CDMX`}
    text_1={t('home.more_info_2')}
    text_2={t('home.more_info_3')}
    day_1=''
    day_2=''
  />
</div>

<style>
  section {
    min-height: 100vh;
  }

  @media (max-width: 768px) {
    section {
      min-height: 80vh;
    }
  }
</style>
