  <div
    class="bg-[url(/img/background_about.webp)] bg-top bg-no-repeat bg-cover bg-fixed relative text-white text-center h-auto md:h-screen p-10 md:p-20 flex items-center justify-center"
    id="nosotros"
  >
    <div
      class="max-w-4xl"
      data-aos="fade-up-left"
      data-aos-delay="300"
      data-aos-duration="1500"
    >
      <img
        src="/img/ecomondo_logo_2025.webp"
        alt="Ecomondo Mexico"
        class="w-[400px] sm:w-48 md:w-56 lg:w-[400px] mx-auto mb-6 object-contain"
      />
      <p
        class="text-xl md:text-2xl leading-relaxed"
        set:html={t("home.eco_description")}
      />
      
      <!-- Botones -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mt-8">
        <!-- Botón Ser Expositor -->
        <a
          href= { lang === "en" 
            ? "https://expositor.amofexpo.igeco.mx/en/" 
            : "https://expositor.amofexpo.igeco.mx/" 
          }
          target="_blank"
          class="inline-flex items-center justify-center gap-2 rounded-full border-2 border-white px-6 py-3 text-lg md:text-xl font-semibold text-white hover:bg-white/10 transition duration-300 uppercase"
          aria-label="quiero ser expositor"
        >
          {t("home.more_info")}
          <svg
            width="24px"
            height="24px"
            viewBox="0 0 24 24"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            ><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g
              id="SVGRepo_tracerCarrier"
              stroke-linecap="round"
              stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier">
              <path
                d="M4 12H20M20 12L14 6M20 12L14 18"
                stroke="#ffffff"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </g></svg
          >
        </a>

        <!-- Botón Visitar Ecomondo -->
        <a
          href="https://ecomondomexico.com.mx/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 rounded-full bg-white/20 backdrop-blur-sm border-2 border-white px-6 py-3 text-lg md:text-xl font-semibold text-white hover:bg-white hover:text-gray-900 transition duration-300 uppercase"
          aria-label="visitar sitio de ecomondo"
        >
          {lang === "en" ? "Visit Ecomondo" : "Visitar Ecomondo"}
          <svg
            width="24px"
            height="24px"
            viewBox="0 0 24 24"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <g stroke-width="0"></g>
            <g stroke-linecap="round" stroke-linejoin="round"></g>
            <g>
              <path
                d="M10 5H8.2C7.0799 5 6.51984 5 6.09202 5.21799C5.71569 5.40973 5.40973 5.71569 5.21799 6.09202C5 6.51984 5 7.0799 5 8.2V15.8C5 16.9201 5 17.4802 5.21799 17.908C5.40973 18.2843 5.71569 18.5903 6.09202 18.782C6.51984 19 7.0799 19 8.2 19H15.8C16.9201 19 17.4802 19 17.908 18.782C18.2843 18.5903 18.5903 18.2843 18.782 17.908C19 17.4802 19 16.9201 19 15.8V14M15 5H19M19 5V9M19 5L10 14"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></path>
            </g>
          </svg>
        </a>
      </div>
    </div>
  </div>
  <div
    class="bg-[url(/img/background_about.webp)] bg-top bg-no-repeat bg-cover bg-fixed relative text-white text-center h-auto md:h-screen p-10 flex items-center justify-center"
  >
    <div class="max-w-6xl">
      <h1
        class="text-xl md:text-5xl uppercase font-black leading-relaxed" data-aos="zoom-out" data-aos-delay="300" data-aos-duration="1500"
        set:html={t("home.eco_desc_01")}
      />
      <p
        class="text-xl md:text-2xl leading-relaxed" data-aos="fade-right" data-aos-delay="800" data-aos-duration="1500"
        set:html={t("home.eco_desc_02")}
      />
    </div>
  </div>
</section>
