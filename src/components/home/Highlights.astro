---
import { Numbers } from '../shared/Numbers.jsx'
import { t } from 'i18next'
---
<section class='md:my-10'>
  <div class='container mx-auto px-4 my-10'>
    <p
      data-aos='fade-up'
      data-aos-duration='1500'
      class='text-[#2366e7] text-4xl md:text-5xl font-extrabold text-center md:p-10 uppercase'
    >
      Highlights
    </p>
    <div
      class='grid grid-cols-2 md:flex md:flex-row md:flex-wrap gap-2 mt-10 justify-center mx-auto'
    >
      <div
        data-aos='fade-up'
        data-aos-duration='1600'
        class='text-center rounded-tr-3xl rounded-bl-3xl p-5 shadow-lg border-l-4 card-background text-white font-bold'
      >
        <svg
          xmlns='http://www.w3.org/2000/svg'
          fill='none'
          viewBox='0 0 24 24'
          stroke-width='1.5'
          stroke='currentColor'
          class='h-16 w-16 mx-auto mb-3'
        >
          <path
            stroke-linecap='round'
            stroke-linejoin='round'
            d='M12 18.75a6 6 0 0 0 6-6v-1.5m-6 7.5a6 6 0 0 1-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15.75a3 3 0 0 1-3-3V4.5a3 3 0 1 1 6 0v8.25a3 3 0 0 1-3 3Z'
          ></path>
        </svg>

        <p class='font-extrabold text-4xl opacity-0'>+</p>
        <p>
          {t('home.cifras_1')}
        </p>
      </div>

      <div
        data-aos='fade-up'
        data-aos-duration='1700'
        class='text-center rounded-tr-3xl rounded-bl-3xl p-5 shadow-lg border-l-4 card-background text-white font-bold'
      >
        <img src='/img/iconsegmentos2.png' class='mx-auto mb-3 h-16' />
        <p class='font-extrabold text-4xl'>
          + <Numbers client:only='react' number='220' duration='5' />
        </p>
        <p>{t('home.cifras_2')}</p>
      </div>

      <div
        data-aos='fade-up'
        data-aos-duration='1800'
        class='text-center rounded-tr-3xl rounded-bl-3xl p-5 shadow-lg border-l-4 card-background text-white font-bold'
      >
        <img src='/img/iconsegmentos3.png' class='mx-auto mb-3 h-16' />
        <p class='font-extrabold text-4xl'>
          + <Numbers client:only='react' number='11000' duration='5' />
        </p>
        <p>
          {t('home.cifras_3')}
        </p>
      </div>

      <div
        data-aos='fade-up'
        data-aos-duration='2000'
        class='text-center rounded-tr-3xl rounded-bl-3xl p-5 shadow-lg border-l-4 card-background text-white font-bold'
      >
        <img src='/img/iconsegmentos5.png' class='mx-auto mb-3 h-16' />
        <p class='font-extrabold text-4xl opacity-0'>+</p>
        <p>{t('home.cifras_4')}</p>
      </div>
      <div
        data-aos='fade-up'
        data-aos-duration='2000'
        class='text-center rounded-tr-3xl rounded-bl-3xl p-5 shadow-lg border-l-4 card-background text-white font-bold'
      >
        <img src='/img/iconsegmentos4.png' class='mx-auto mb-3 h-16' />
        <p class='font-extrabold text-4xl opacity-0'>+</p>
        <p>{t('home.cifras_5')}</p>
      </div>
    </div>
    <p data-aos='fade-up' data-aos-duration='1500' class='mt-10 text-center italic font-semibold text-gray-600'>
      * {t('home.cifras_conjunto')} *
    </p>
  </div>
</section>
<style>
  .card-background {
    background: linear-gradient(
      135deg,
      #004e9e 0%,
      #0071bc 25%,
      #0aa37a 60%,
      #2b9361 100%
    );
    color: #ffffff;
    background-size: 200% 200%;
    transition: background-position 0.6s ease, box-shadow 0.3s ease;
    box-shadow: 0 6px 18px rgba(11, 62, 94, 0.12);
  }

  .card-background:hover {
    background-position: 100% 0;
    box-shadow: 0 10px 30px rgba(11, 62, 94, 0.18);
  }
</style>
