---
import { Numbers } from '../shared/Numbers.jsx'
import { t } from 'i18next'
---
<section class="mt-10">
  <p class="text-[#2366e7] text-4xl md:text-5xl font-extrabold text-center uppercase">
    Highlights
  </p>
  <div class="grid grid-cols-2 md:flex md:justify-center gap-4 md:gap-8 px-4">
    <!-- Card 1: Cifras 1 -->
    <div
      class="h-[500px] md:w-[200px] mt-10 relative overflow-hidden shadow-2xl shadow-[#181a1c]"
      data-aos="zoom-in"
      data-aos-delay="300"
    >
      <img 
        src="/img/highlights/hgt_amof_01.webp" 
        alt="Highlight 1" 
        class="absolute inset-0 w-full h-full object-cover object-center"
      />
      <div
        class="absolute inset-0 bg-gradient-to-t from-[#2366e7] from-2% via-transparent via-50% to-transparent px-2 pb-6 text-white flex items-end"
      >
        <p
          class="text-center uppercase font-extrabold text-lg md:text-xl leading-tight w-full"
        >
          {t("home.cifras_1")}
        </p>
      </div>
    </div>

    <!-- Card 2: Cifras 2 (220 con Numbers) -->
    <div
      class="h-[500px] md:w-[200px] mt-10 relative overflow-hidden shadow-2xl shadow-[#181a1c]"
      data-aos="zoom-in"
      data-aos-delay="600"
    >
      <img 
        src="/img/highlights/hgt_02.webp" 
        alt="Highlight 2" 
        class="absolute inset-0 w-full h-full object-cover object-center"
      />
      <div
        class="absolute inset-0 bg-gradient-to-t from-[#2366e7] from-2% via-transparent via-30% to-transparent px-2 pb-6 text-white flex items-end justify-center"
      >
        <p class="text-center uppercase font-extrabold leading-tight w-full">
          <span class="block font-extrabold text-3xl md:text-4xl mb-2">
            +<Numbers client:only="react" number="220" duration="5" />
          </span>
          <span class="block text-lg md:text-xl">{t("home.cifras_2")}</span>
        </p>
      </div>
    </div>

    <!-- Card 3: Cifras 3 (11000 con Numbers) -->
    <div
      class="h-[500px] md:w-[200px] mt-10 relative overflow-hidden shadow-2xl shadow-[#181a1c]"
      data-aos="zoom-in"
      data-aos-delay="900"
    >
      <img 
        src="/img/highlights/hgt_amof_03.webp" 
        alt="Highlight 3" 
        class="absolute inset-0 w-full h-full object-cover object-center"
      />
      <div
        class="absolute inset-0 bg-gradient-to-t from-[#2366e7] from-2% via-transparent via-40% to-transparent px-2 pb-6 text-white flex items-end"
      >
        <p class="text-center uppercase font-extrabold leading-tight w-full">
          <span class="block font-extrabold text-3xl md:text-4xl mb-2"
            >+<Numbers client:only="react" number="11000" duration="5" /></span
          >
          <span class="block text-sm md:text-sm text-center">
            {t("home.cifras_3")}
          </span>
        </p>
      </div>
    </div>

    <!-- Card 4: Cifras 4 -->
    <div
      class="h-[500px] md:w-[200px] mt-10 relative overflow-hidden shadow-2xl shadow-[#181a1c]"
      data-aos="zoom-in"
      data-aos-delay="1200"
    >
      <img 
        src="/img/highlights/hgt_amof_04.webp" 
        alt="Highlight 4" 
        class="absolute inset-0 w-full h-full object-cover object-center"
      />
      <div
        class="absolute inset-0 bg-gradient-to-t from-[#2366e7] from-2% via-transparent via-40% to-transparent px-2 pb-6 text-white flex items-end"
      >
        <p
          class="text-center uppercase font-extrabold text-lg md:text-xl leading-tight w-full"
        >
          {t("home.cifras_4")}
        </p>
      </div>
    </div>

    <!-- Card 5: Cifras 5 -->
    <div
      class="h-[500px] md:w-[200px] mt-10 relative overflow-hidden shadow-2xl shadow-[#181a1c]"
      data-aos="zoom-in"
      data-aos-delay="1500"
    >
      <img 
        src="/img/highlights/hgt_amof_05.webp" 
        alt="Highlight 5" 
        class="absolute inset-0 w-full h-full object-cover object-center"
      />
      <div
        class="absolute inset-0 bg-gradient-to-t from-[#2366e7] from-2% via-transparent via-40% to-transparent px-2 pb-6 text-white flex items-end"
      >
        <p
          class="text-center uppercase font-extrabold text-lg md:text-xl leading-tight w-full"
        >
          {t("home.cifras_5")}
        </p>
      </div>
    </div>
  </div>
  <p data-aos='fade-up' data-aos-duration='1500' class='mt-10 text-center italic font-semibold text-gray-600'>
      * {t('home.cifras_conjunto')} *
    </p>
</section>
