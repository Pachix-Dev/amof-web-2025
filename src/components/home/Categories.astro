---
import { t } from "i18next";
import { SliderSwiper } from "./SliderSwiper";

const registerTranslations = t("home", { returnObjects: true });
---

<section
  class="py-20 bacjkground-section text-white"
  id="perfil-expositor"
>
  <p class="font-bold uppercase text-4xl text-center mb-10">
    {t("home.title3")}
  </p>
  <SliderSwiper t={registerTranslations} client:only />
</section>
<style>
  .bacjkground-section {
     background: linear-gradient(
      135deg,
      #004e9e 0%,
      #0071bc 25%,
      #0aa37a 60%,
      #2b9361 100%
    );
    color: #ffffff;
    background-size: 200% 200%;
    transition: background-position 0.6s ease, box-shadow 0.3s ease;
    box-shadow: 0 6px 18px rgba(11, 62, 94, 0.12);
  }
</style>