---
import { t } from "i18next";
---

<section class="mt-15 mb-20">
  <div class="flex justify-end mb-10">
    <p
      class="text-center text-white text-4xl bg-[#0578F9] rounded-tl-[40px]
        rounded-bl-[40px] w-full max-w-4xl py-4 px-8 uppercase font-bold"
    >
      {t("summit.showroom")}
    </p>
  </div>
  <div class="flex flex-col lg:flex-row px-10 lg:px-20 gap-10">
    <div class="lg:w-1/3 flex justify-center items-center">
      <img
        src="/img/summit/amof_stand_hyperskill.jpg"
        alt="Amof stands"
        class="max-w-full h-auto rounded-2xl"
      />
    </div>
    <div class="lg:w-2/3 flex flex-col justify-center items-center gap-10">
      <div class="flex gap-5 text-center">
        <div
          class="w-1/3 bg-blue-700 rounded-3xl p-6 text-white text-lg md:text-4xl lg:text-4xl flex justify-center items-center"
        >
          <p>
            $250 p/m² <br />
            <strong>USD</strong> + IVA
          </p>
        </div>
        <div
          class="w-2/3 border-blue-500 border-solid border-4 rounded-3xl p-6 text-black text-sm md:text-lg lg:text-lg"
        >
          <p set:html={t("summit.showromm_1")} />
        </div>
      </div>
      <div class="flex gap-5 text-center">
        <div
          class="w-2/3 border-blue-500 border-solid border-4 rounded-3xl p-6 text-black text-sm md:text-lg lg:text-lg"
        >
          <p set:html={t("summit.showromm_2")} />
        </div>
        <div
          class="w-1/3 bg-blue-700 rounded-3xl p-6 text-white text-lg md:text-4xl lg:text-4xl flex justify-center items-center"
        >
          <p>
            $350 p/m² <br />
            <strong>USD</strong> + IVA
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
