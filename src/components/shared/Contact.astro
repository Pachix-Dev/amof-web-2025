---
import { t } from "i18next";
---
<section id="contacto" class="relative py-12 md:py-14 bg-[url(/img/background_about.webp)] bg-cover bg-center">
    <!-- Overlay para mejorar legibilidad -->
    <div class="absolute inset-0 bg-gradient-to-b from-blue-900/25 via-blue-800/10 to-blue-900/35"></div>
    
    <div class="relative container mx-auto px-4 max-w-6xl flex flex-col items-center">
        <div class="text-center mb-12 md:mb-16">
            <h2 class="text-3xl sm:text-4xl md:text-6xl font-bold mb-4 md:mb-6 text-white drop-shadow-lg uppercase">
                {t("contact.title")}
            </h2>
            <p class="text-lg sm:text-xl md:text-xl max-w-xl mx-auto text-blue-50 drop-shadow-md font-medium" set:html={t("contact.description")}></p>
        </div>

        <div class="bg-white/10 backdrop-blur-md rounded-3xl p-6 sm:p-8 md:p-12 border border-white/20 shadow-2xl max-w-4xl w-full">
            <div class="flex flex-col md:flex-row md:items-center gap-6 md:gap-12">
                <div class="flex justify-center md:justify-start flex-shrink-0">
                    <div class="relative">
                        <img
                            src="/img/pauSanchez.webp"
                            alt="Paulina Sánchez"
                            class="w-36 h-36 sm:w-[220px] sm:h-[220px] md:w-[280px] md:h-[280px] rounded-full object-cover object-top border-4 border-white/30 shadow-xl"
                        />
                        <div class="absolute -bottom-2 -right-2 w-12 h-12 sm:w-16 sm:h-16 bg-green-500 rounded-full border-4 border-white flex items-center justify-center shadow-lg">
                            <svg aria-hidden="true" focusable="false" class="w-5 h-5 sm:w-8 sm:h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" role="img">
                                <title>Disponible</title>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                            </svg>
                        </div>
                    </div>
                </div>

                <div class="flex flex-col justify-center text-center md:text-left flex-1">
                    <h3 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold mb-1 md:mb-3 text-white drop-shadow-lg">
                        Paulina Sánchez
                    </h3>
                    <p class="text-sm sm:text-lg md:text-2xl font-semibold mb-6 md:mb-8 text-blue-100 drop-shadow-md">
                       Sustainability Leader / Business Development
                    </p>

                    <ul class="space-y-4 sm:space-y-5">
                        <li>
                            <a
                                class="flex items-center justify-center md:justify-start gap-3 group focus:outline-none focus:ring-2 focus:ring-blue-300 rounded-lg"
                                href="mailto:paulina.sanchez@igeco.mx"
                                aria-label="Enviar correo a Paulina Sánchez"
                            >
                                <div class="w-10 h-10 sm:w-12 sm:h-12 bg-white/20 rounded-full flex items-center justify-center group-hover:bg-white/30 transition-all duration-300 border border-white/30">
                                    <svg aria-hidden="true" focusable="false" class="w-4 h-4 sm:w-6 sm:h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" role="img">
                                        <title>Correo electrónico</title>
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                                    </svg>
                                </div>
                                <span class="text-base sm:text-xl font-semibold text-white group-hover:text-blue-200 transition-colors duration-200 drop-shadow-md break-words">
                                    paulina.sanchez@igeco.mx
                                </span>
                            </a>
                        </li>
                        
                        <li>
                            <div class="flex items-center justify-center md:justify-start gap-3 group focus:outline-none focus:ring-2 focus:ring-blue-300 rounded-lg">
                                <div class="w-10 h-10 sm:w-12 sm:h-12 bg-white/20 rounded-full flex items-center justify-center group-hover:bg-white/30 transition-all duration-300 border border-white/30">
                                    <svg aria-hidden="true" focusable="false" class="w-4 h-4 sm:w-6 sm:h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" role="img">
                                        <title>Teléfono</title>
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                                    </svg>
                                </div>
                                <span class="text-base sm:text-xl font-semibold text-white group-hover:text-blue-200 transition-colors duration-200 drop-shadow-md">
                                   +52 1 442 710 3765
                                </span>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>
