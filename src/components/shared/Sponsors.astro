---
interface Partner {
  link?: string
  src?: string
  alt?: string
  width?: number
  height?: number // Hacemos height opcional
}

interface Props {
  logos: Partner[]
}

const { logos } = Astro.props
---

<div
  class='grid grid-cols-[repeat(auto-fit,_minmax(150px,_max-content))] justify-center *:grid *:place-items-center *:w-full *:h-full gap-6 *:bg-white *:rounded-lg *:shadow-lg *:p-2'
>
  {
    logos.map((element) => (
      <a href={element.link} target='_blank' rel='noopener noreferrer'>
        <img src={element.src} alt={element.alt} width={element.width} />
      </a>
    ))
  }
</div>
